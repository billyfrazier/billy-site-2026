---
import '../styles/global.css';
const hasBust = true;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Billy Frazier</title>
  <meta name="description" content="Billy Frazier — writer, speaker, author of Fumbling Forward. Fumbling forward through work and life while sharing notes with the rest of the class." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href="https://billyfrazier.is/" />
  <meta property="og:title" content="Billy Frazier" />
  <meta property="og:description" content="Fumbling forward through work and life while sharing notes with the rest of the class." />
  <meta property="og:type" content="website" />
  {hasBust && <link rel="preload" href="/models/billy-body.glb" as="fetch" crossorigin="anonymous" />}
</head>
<body data-has-bust={hasBust || undefined}>
  <div class="stage" id="stage" aria-hidden="true"></div>

  <header class="site-header">
    <a class="logo" href="/"><img src="/logo.svg" alt="Billy Frazier" width="164" height="32" /></a>
    <button class="menu-btn" id="menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="site-menu">
      <span></span><span></span><span></span>
    </button>
  </header>

  <!-- Site menu: the home for separate pages as they arrive. -->
  <nav class="site-menu" id="site-menu" aria-label="Site" hidden>
    <ul>
      <li><a href="mailto:hello@billyfrazier.is">Let's talk</a></li>
    </ul>
  </nav>

  <main class="col">
    <p class="intro-line">Hi, I'm Billy Frazier, an author, experience designer, leader, and forward fumbler.</p>
    <h1 class="headline" aria-live="polite"><span id="headline"></span><span class="cursor" id="cursor" aria-hidden="true"></span></h1>
    <ul class="reply-list" id="replylist" aria-live="polite"></ul>
    <nav class="chips" aria-label="What would you like to do?">
      <button class="chip" data-reply="help">Learn how I can help</button>
      <button class="chip" data-reply="book">Buy my book</button>
      <button class="chip" data-reply="substack">Subscribe to my Substack</button>
      <button class="chip" data-reply="contact">Drop a quick line</button>
    </nav>
    <div class="followup" id="followup"></div>
  </main>

  <div class="bottom-left">
    <button class="reset-btn" id="reset" aria-label="Start over">↺</button>
    <div class="progress" role="presentation"><i></i></div>
  </div>

  <div class="bottom-right">
    <button class="chip motion-chip" id="motion-chip" hidden>Enable motion</button>
  </div>

  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
